# FireSight AI Environment Configuration
# Problem Statement PS 11: Automated Forest Fire Prediction & Spread Simulation
# Team: The ByteForce

# Application Settings
APP_NAME="FireSight AI"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"

# NASA FIRMS API (Active Fire / Thermal Anomaly Data)
# Obtain a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left empty, the application runs seamlessly in verified synthetic demo mode.
NASA_FIRMS_MAP_KEY=""
NASA_FIRMS_BASE_URL="https://firms.modaps.eosdis.nasa.gov/api"

# Open-Meteo API (Meteorological Forecasts & Telemetry)
# Free public endpoint (No API key required)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"

# ISRO VEDAS Integration Configuration
ISRO_VEDAS_ENABLED=true
ISRO_VEDAS_PORTAL_URL="https://vedas.sac.gov.in/en/"

# Operational Mode
# Set to true to force synthetic demo observations even if external credentials exist
FORCE_DEMO_MODE=false

# Risk Engine Configurable Weights (Must sum to 1.0)
WEIGHT_HOTSPOT_PROXIMITY=0.35
WEIGHT_RELATIVE_HUMIDITY=0.20
WEIGHT_TEMPERATURE=0.15
WEIGHT_WIND_SPEED=0.15
WEIGHT_PRECIPITATION_DAMPENER=0.10
WEIGHT_VEGETATION_FUEL=0.05

# Risk Categorization Thresholds
RISK_THRESHOLD_LOW=0.35
RISK_THRESHOLD_MEDIUM=0.70
